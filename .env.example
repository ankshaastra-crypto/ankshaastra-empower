# Copy to .env and fill in real values. Never commit .env.

# Frontend (Vite — exposed to browser; use anon/publishable keys only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_PROJECT_ID=your_project_ref
VITE_RAZORPAY_KEY_ID=rzp_live_xxx

# Backend (server only — set in Vercel env vars for production)
DATABASE_URL=postgresql://postgres.your-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
ENCRYPTION_KEY=your_32_plus_character_secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=Ankshaastra <your_email@gmail.com>
ADMIN_EMAIL=admin@example.com
