# ===============================
# Vercel Environment Variables
# ===============================
# Add these in:
# Vercel Dashboard -> Project -> Settings -> Environment Variables
# (Production, Preview, Development as needed)

# -------------------------------
# Required: Razorpay
# -------------------------------
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Frontend uses this key at build time
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx

# -------------------------------
# Required: Database (Supabase Postgres Pooler)
# -------------------------------
# Use Supabase pooler URI (usually port 6543), not direct DB host.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# -------------------------------
# Required: SMTP Email (Vercel runtime)
# -------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_SECURE=false
FROM_EMAIL=Ankshaastra <your_email@gmail.com>
ADMIN_EMAIL=your_admin_email@example.com

# -------------------------------
# Required: Security
# -------------------------------
# 32+ chars recommended
ENCRYPTION_KEY=replace_with_long_random_secret_min_32_chars

# -------------------------------
# Required: Frontend Vite vars (build-time)
# -------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_PROJECT_ID=your_project_ref

# -------------------------------
# Optional: Backend Supabase service role
# (needed if invoice/storage logic uses Supabase API directly)
# -------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -------------------------------
# Optional: Cache / runtime
# -------------------------------
REDIS_URL=redis://localhost:6379
NODE_ENV=production
NODE_OPTIONS=--no-deprecation

# -------------------------------
# Optional: Pricing override (server-side validation)
# -------------------------------
PACKAGE_SINGLE_PRICE=1997
PACKAGE_PREMIUM_PRICE=5100
PACKAGE_NAMECHECK_1_PRICE=199
PACKAGE_NAMECHECK_2_PRICE=299
PACKAGE_NAMECHECK_3_PRICE=399
PACKAGE_CONSULTATION_PRICE=499

# -------------------------------
# Optional: Frontend pricing display
# -------------------------------
VITE_PACKAGE_NAMECHECK_PRICE=199
VITE_PACKAGE_NAMECHECK_ORIGINAL_PRICE=199
VITE_PACKAGE_SINGLE_PRICE=1997
VITE_PACKAGE_SINGLE_ORIGINAL_PRICE=5100
