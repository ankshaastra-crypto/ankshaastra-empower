<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice <%= invoiceNumber %></title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Arial', sans-serif;
            background: #f5f5f5;
            padding: 10px;
        }
        
        .invoice-container {
            max-width: 100%;
            margin: 0 auto;
            background: white;
            padding: 20px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            position: relative;
        }
        
        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-45deg);
            opacity: 0.05;
            font-size: 80px;
            font-weight: bold;
            color: #000;
            z-index: 0;
            pointer-events: none;
        }
        
        .content {
            position: relative;
            z-index: 1;
        }
        
        .header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            border-bottom: 2px solid #8B5CF6;
            padding-bottom: 10px;
        }
        
        .company-info h1 {
            color: #8B5CF6;
            font-size: 20px;
            margin-bottom: 5px;
        }
        
        .company-info p {
            color: #666;
            font-size: 11px;
            line-height: 1.4;
            margin: 2px 0;
        }
        
        .invoice-details {
            text-align: right;
        }
        
        .invoice-details h2 {
            color: #333;
            font-size: 18px;
            margin-bottom: 5px;
        }
        
        .invoice-details p {
            color: #666;
            font-size: 11px;
            margin: 2px 0;
        }
        
        .customer-section {
            margin-bottom: 12px;
        }
        
        .customer-section h3 {
            color: #8B5CF6;
            font-size: 14px;
            margin-bottom: 6px;
            border-bottom: 1px solid #f0f0f0;
            padding-bottom: 3px;
        }
        
        .customer-info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        
        .info-item {
            margin-bottom: 4px;
        }
        
        .info-item strong {
            color: #333;
            display: block;
            margin-bottom: 2px;
            font-size: 11px;
        }
        
        .info-item span {
            color: #666;
            font-size: 11px;
        }
        
        .items-section {
            margin: 12px 0;
        }
        
        .items-section h3 {
            color: #8B5CF6;
            font-size: 14px;
            margin-bottom: 8px;
            border-bottom: 1px solid #f0f0f0;
            padding-bottom: 3px;
        }
        
        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        
        .items-table th {
            background: #8B5CF6;
            color: white;
            padding: 6px 8px;
            text-align: left;
            font-weight: 600;
            font-size: 11px;
        }
        
        .items-table td {
            padding: 6px 8px;
            border-bottom: 1px solid #f0f0f0;
            font-size: 11px;
        }
        
        .items-table tr:hover {
            background: #f9f9f9;
        }
        
        .text-right {
            text-align: right;
        }
        
        .total-section {
            margin-top: 12px;
            text-align: right;
        }
        
        .total-row {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 4px;
        }
        
        .total-label {
            width: 150px;
            text-align: right;
            padding-right: 15px;
            font-weight: 600;
            color: #333;
            font-size: 11px;
        }
        
        .total-value {
            width: 120px;
            text-align: right;
            color: #8B5CF6;
            font-weight: bold;
            font-size: 13px;
        }
        
        .grand-total {
            border-top: 2px solid #8B5CF6;
            padding-top: 5px;
            margin-top: 5px;
        }
        
        .grand-total .total-value {
            font-size: 16px;
            color: #8B5CF6;
        }
        
        .payment-section {
            margin-top: 12px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }
        
        .bank-details, .upi-section {
            background: #f9f9f9;
            padding: 10px;
            border-radius: 6px;
        }
        
        .bank-details h4, .upi-section h4 {
            color: #8B5CF6;
            margin-bottom: 8px;
            font-size: 12px;
        }
        
        .bank-details p, .upi-section p {
            color: #666;
            font-size: 10px;
            margin: 3px 0;
            line-height: 1.4;
        }
        
        .qr-code {
            text-align: center;
            margin-top: 8px;
        }
        
        .qr-code img {
            max-width: 120px;
            border: 1px solid #ddd;
            border-radius: 4px;
            padding: 5px;
            background: white;
        }
        
        .notes-section {
            margin-top: 12px;
            padding: 10px;
            background: #fff8e1;
            border-left: 3px solid #ffc107;
        }
        
        .notes-section h4 {
            color: #8B5CF6;
            margin-bottom: 6px;
            font-size: 12px;
        }
        
        .notes-section p {
            color: #666;
            font-size: 10px;
            line-height: 1.4;
            margin: 3px 0;
        }
        
        .terms-section {
            margin-top: 12px;
            padding: 10px;
            background: #f5f5f5;
            border-radius: 6px;
        }
        
        .terms-section h4 {
            color: #8B5CF6;
            margin-bottom: 6px;
            font-size: 12px;
        }
        
        .terms-section p {
            color: #666;
            font-size: 9px;
            line-height: 1.4;
            margin: 3px 0;
        }
        
        .footer {
            margin-top: 12px;
            text-align: center;
            color: #999;
            font-size: 9px;
            border-top: 1px solid #f0f0f0;
            padding-top: 8px;
        }
        
        @media print {
            body {
                background: white;
                padding: 0;
            }
            
            .invoice-container {
                box-shadow: none;
            }
        }
    </style>
</head>
<body>
    <div class="invoice-container">
        <div class="watermark"><%= company.name %></div>
        
        <div class="content">
            <div class="header">
                <div class="company-info">
                    <h1><%= company.name %></h1>
                    <p><%= company.address %></p>
                    <p>Phone: <%= company.phone %></p>
                    <p>Email: <%= company.email %></p>
                    <p>GSTIN: <%= company.gstin %></p>
                </div>
                
                <div class="invoice-details">
                    <h2>INVOICE</h2>
                    <p><strong>Invoice No:</strong> <%= invoiceNumber %></p>
                    <p><strong>Date:</strong> <%= invoiceDate %></p>
                    <p><strong>Due Date:</strong> <%= dueDate %></p>
                </div>
            </div>
            
            <div class="customer-section">
                <h3>Bill To</h3>
                <div class="customer-info">
                    <div>
                        <div class="info-item">
                            <strong>Name:</strong>
                            <span><%= customer.name %></span>
                        </div>
                        <div class="info-item">
                            <strong>Email:</strong>
                            <span><%= customer.email %></span>
                        </div>
                    </div>
                    <div>
                        <div class="info-item">
                            <strong>Phone:</strong>
                            <span><%= customer.phone %></span>
                        </div>
                        <% if (customer.address) { %>
                        <div class="info-item">
                            <strong>Address:</strong>
                            <span><%= customer.address %></span>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
            
            <div class="items-section">
                <h3>Items</h3>
                <table class="items-table">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th class="text-right">Quantity</th>
                            <th class="text-right">Unit Price</th>
                            <th class="text-right">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% items.forEach(function(item) { %>
                        <tr>
                            <td>
                                <strong><%= item.name %></strong>
                                <% if (item.description) { %>
                                <br><small style="color: #666;"><%= item.description %></small>
                                <% } %>
                            </td>
                            <td class="text-right"><%= item.quantity %></td>
                            <td class="text-right">₹<%= item.unitPrice.toLocaleString('en-IN') %></td>
                            <td class="text-right">₹<%= item.total.toLocaleString('en-IN') %></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            
            <div class="total-section">
                <div class="total-row">
                    <div class="total-label">Subtotal:</div>
                    <div class="total-value">₹<%= subtotal.toLocaleString('en-IN') %></div>
                </div>
                <% if (tax > 0) { %>
                <div class="total-row">
                    <div class="total-label">Tax (GST):</div>
                    <div class="total-value">₹<%= tax.toLocaleString('en-IN') %></div>
                </div>
                <% } %>
                <% if (discount > 0) { %>
                <div class="total-row">
                    <div class="total-label">Discount:</div>
                    <div class="total-value">-₹<%= discount.toLocaleString('en-IN') %></div>
                </div>
                <% } %>
                <div class="total-row grand-total">
                    <div class="total-label">Total Amount:</div>
                    <div class="total-value">₹<%= total.toLocaleString('en-IN') %></div>
                </div>
            </div>
            
            <div class="payment-section">
                <div class="bank-details">
                    <h4>Bank Details</h4>
                    <p><strong>Bank Name:</strong> <%= bankDetails.name %></p>
                    <p><strong>Account Number:</strong> <%= bankDetails.accountNumber %></p>
                    <p><strong>IFSC Code:</strong> <%= bankDetails.ifsc %></p>
                    <p><strong>Account Holder:</strong> <%= bankDetails.accountHolder %></p>
                    <% if (bankDetails.branch) { %>
                    <p><strong>Branch:</strong> <%= bankDetails.branch %></p>
                    <% } %>
                </div>
                
                <div class="upi-section">
                    <h4>UPI Payment</h4>
                    <% if (upiDetails.qrCode) { %>
                    <div class="qr-code">
                        <img src="<%= upiDetails.qrCode %>" alt="UPI QR Code">
                    </div>
                    <% } %>
                    <% if (upiDetails.upiId) { %>
                    <p style="text-align: center; margin-top: 10px;">
                        <strong>UPI ID:</strong> <%= upiDetails.upiId %>
                    </p>
                    <% } %>
                </div>
            </div>
            
            <% if (notes && notes.length > 0) { %>
            <div class="notes-section">
                <h4>Notes</h4>
                <% notes.forEach(function(note) { %>
                <p><%= note %></p>
                <% }); %>
            </div>
            <% } %>
            
            <div class="terms-section">
                <h4>Terms & Conditions</h4>
                <% terms.forEach(function(term) { %>
                <p><%= term %></p>
                <% }); %>
            </div>
            
            <div class="footer">
                <p>Thank you for your business!</p>
                <p>This is a computer-generated invoice and does not require a signature.</p>
            </div>
        </div>
    </div>
</body>
</html>
